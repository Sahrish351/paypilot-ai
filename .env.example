# ============================================================
# PayPilot AI - Environment Configuration Template
# ============================================================
# Copy this file to `.env` (never commit `.env` to Git):
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS / Linux:      cp .env.example .env
# ============================================================

# [OPTIONAL] Express + Vite server port (default: 3000)
PORT=3000

# [REQUIRED IN PRODUCTION] Central public application URL (no trailing slash)
# Local development: http://localhost:3000
# Render production: https://paypilot-ai-zz8c.onrender.com
APP_URL="http://localhost:3000"

# [RECOMMENDED / REQUIRED IN PRODUCTION] Secret used to sign HMAC-SHA256 session tokens
# Generate a 32+ character random secret string before deploying.
AUTH_SECRET="replace-with-a-long-random-secret-string"

# [OPTIONAL - REQUIRED FOR LIVE GEMINI AI] Google Gemini API key
# Obtain from https://aistudio.google.com/apikey
# If omitted or left blank, /ai-agent transparently runs in deterministic heuristic-fallback mode.
GEMINI_API_KEY=""

# [OPTIONAL] Gemini model identifier (default: gemini-3-flash-preview)
GEMINI_MODEL="gemini-3-flash-preview"

# [OPTIONAL - REQUIRED FOR LIVE PAYPAL SANDBOX CHECKOUT]
# Obtain Sandbox REST API credentials from:
# https://developer.paypal.com/dashboard/applications/sandbox
# Without these, PayPilot AI will NOT fake payment completions (returns 503 with setup instructions).
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# [OPTIONAL] PayPal API base URL (keep Sandbox URL for hackathon testing)
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"

# [OPTIONAL] Custom path for JSON database persistence file (default: data/store.json)
# PAYPILOT_DB_FILE="data/store.json"
