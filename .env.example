# ==========================================
# PayPilot AI - Environment Configuration
# ==========================================

# Server Port (default: 3000)
PORT=3000

# Public URL where this application is hosted (used for PayPal return/cancel URLs and payment links)
APP_URL="http://localhost:3000"

# Secret used to sign authentication session tokens (generate a long random string in production)
AUTH_SECRET="replace-with-a-long-random-secret-string"

# Google Gemini API Key (required for live Gemini AI parsing and financial insights)
# When omitted, PayPilot AI runs in transparent heuristic-parser fallback mode.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# PayPal Developer Sandbox Credentials (required for live PayPal Sandbox Orders API v2 checkout)
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
